rules_version = '2';
// Claims, scores and leaderboards are READ-ONLY to clients. Only Cloud
// Functions (admin SDK) may write them, which keeps scoring, stealing and
// leaderboard standings server-authoritative and uncheatable.
service cloud.firestore {
  match /databases/{database}/documents {
    match /claims/{claimId} {
      allow read: if request.auth != null;
      allow write: if false; // only submitDrive writes claims
    }
    match /players/{playerId} {
      allow read: if request.auth != null;
      allow write: if false; // national scores set by the server only
    }
    match /leaderboard_state/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // per-state scores set by the server only
    }
  }
}
